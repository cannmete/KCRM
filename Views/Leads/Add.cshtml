@model KCRM.Models.Lead
@{
    ViewData["Title"] = "Yeni Aday Ekle";
    Layout = "_LayoutPorto";
}

<section role="main" class="content-body">
    <header class="page-header">
        <h2>Yeni Aday Ekle</h2>
    </header>

    <div class="row">
        <div class="col-lg-8">
            <section class="card card-modern">
                <div class="card-body">
                    <form asp-action="Add" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="form-group mb-3">
                            <label class="control-label">İsim Soyisim *</label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 form-group mb-3">
                                <label class="control-label">Şirket Adı</label>
                                <input asp-for="CompanyName" class="form-control" placeholder="Örn: ABC Ltd." />
                            </div>
                            <div class="col-md-6 form-group mb-3">
                                <label class="control-label">Kaynak</label>
                                <select asp-for="Source" class="form-control">
                                    <option value="">Seçiniz...</option>
                                    <option value="Linkedin">Linkedin</option>
                                    <option value="Referans">Referans</option>
                                    <option value="Web Sitesi">Web Sitesi</option>
                                    <option value="Google">Google Ads</option>
                                    <option value="Diğer">Diğer</option>
                                </select>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 form-group mb-3">
                                <label class="control-label">Email</label>
                                <input asp-for="Email" class="form-control" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 form-group mb-3">
                                <label class="control-label">Telefon</label>
                                <input asp-for="Phone" class="form-control" />
                                <span asp-validation-for="Phone" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-group text-end mt-4">
                            <a asp-action="Index" class="btn btn-default me-2">İptal</a>
                            <button type="submit" class="btn btn-primary">Kaydet</button>
                        </div>
                    </form>
                </div>
            </section>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}