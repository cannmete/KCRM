@model IEnumerable<KCRM.Models.Lead>
@{
    ViewData["Title"] = "Potansiyel Müşteriler";
    Layout = "_LayoutPorto";
}

<section role="main" class="content-body">
    <header class="page-header d-flex justify-content-between align-items-center mb-3">
        <h2>Leads</h2>
        <a asp-action="Add" class="mb-1 mt-1 me-1 btn btn-success">
            <i class="fas fa-plus"></i> Yeni Aday Ekle
        </a>
    </header>

    <section class="card card-modern">
        <header class="card-header">
            <h4 class="card-title">Potansiyel Müşteri Listesi</h4>
        </header>
        <div class="card-body">
            <table class="table table-bordered table-striped mb-0" id="datatable-default">
                <thead>
                    <tr>
                        <th>Ad Soyad</th>
                        <th>Şirket</th> 
                        <th>Kaynak</th> 
                        <th>Email</th>
                        <th>Telefon</th>
                        <th style="width: 10%;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="font-weight-bold">@item.FullName</td>
                            <td>@(item.CompanyName ?? "-")</td>
                            <td><span class="badge badge-info">@(item.Source ?? "Belirtilmedi")</span></td>
                            <td>@item.Email</td>
                            <td>@item.Phone</td>
                            <td class="actions">
                                <div class="d-flex flex-row">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning me-1"><i class="fas fa-edit"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</section>