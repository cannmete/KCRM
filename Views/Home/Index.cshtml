@model KCRM.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_LayoutPorto.cshtml";
}

<header class="page-header mb-4">
    <h2>Dashboard</h2>
</header>

<div class="row">

    <div class="col-xl-4 col-md-6 mb-4">
        <section class="card card-featured card-featured-primary">
            <div class="card-body">
                <div class="widget-summary">
                    <div class="widget-summary-col widget-summary-col-icon">
                        <div class="summary-icon bg-primary">
                            <i class="fas fa-user"></i>
                        </div>
                    </div>
                    <div class="widget-summary-col">
                        <div class="summary">
                            <h4 class="title">Toplam Müşteri</h4>
                            <div class="info">
                                <strong class="amount">@Model.TotalCustomers</strong>
                            </div>
                        </div>
                        <div class="summary-footer">
                            <a href="@Url.Action("Index", "Customer")" class="text-muted text-uppercase">Tüm Müşteriler</a>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <div class="col-xl-4 col-md-6 mb-4">
        <section class="card card-featured card-featured-success">
            <div class="card-body">
                <div class="widget-summary">
                    <div class="widget-summary-col widget-summary-col-icon">
                        <div class="summary-icon bg-success">
                            <i class="fas fa-tasks"></i>
                        </div>
                    </div>
                    <div class="widget-summary-col">
                        <div class="summary">
                            <h4 class="title">Toplam Görev</h4>
                            <div class="info">
                                <strong class="amount">@Model.TotalTasks</strong>
                            </div>
                        </div>
                        <div class="summary-footer">
                            <a href="@Url.Action("Index", "Tasks")" class="text-muted text-uppercase">Görev Listesi</a>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <div class="col-xl-4 col-md-6 mb-4">
        <section class="card card-featured card-featured-warning">
            <div class="card-body">
                <div class="widget-summary">
                    <div class="widget-summary-col widget-summary-col-icon">
                        <div class="summary-icon bg-warning">
                            <i class="fas fa-sticky-note"></i>
                        </div>
                    </div>
                    <div class="widget-summary-col">
                        <div class="summary">
                            <h4 class="title">Toplam Notlar</h4>
                            <div class="info">
                                <strong class="amount">@Model.TotalNotes</strong>
                            </div>
                        </div>
                        <div class="summary-footer">
                            <a href="@Url.Action("Index", "Notes")" class="text-muted text-uppercase">Tüm Notlar</a>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>

</div>


<section class="card card-modern">
    <header class="card-header">
        <h4 class="card-title">Müşteriler</h4>
    </header>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th>Ad</th>
                        <th>Email</th>
                        <th>Telefon</th>
                        <th>Görev Sayısı</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var customer in Model.Customers)
                    {
                        <tr>
                            <td>@customer.FullName</td>
                            <td>@customer.Email</td>
                            <td>@customer.Phone</td>
                            <td>@(customer.Tasks?.Count ?? 0)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>