@model KCRM.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_LayoutPorto.cshtml";
}

<header class="page-header mb-4">
    <h2>Dashboard</h2>
</header>

<div class="row">
    <div class="col-xl-4 col-md-6 mb-4">
        <section class="card card-featured card-featured-primary">
            <div class="card-body">
                <div class="widget-summary">
                    <div class="widget-summary-col widget-summary-col-icon">
                        <div class="summary-icon bg-primary">
                            <i class="fas fa-user"></i>
                        </div>
                    </div>
                    <div class="widget-summary-col">
                        <div class="summary">
                            <h4 class="title">Toplam Müşteri</h4>
                            <div class="info">
                                <strong class="amount">@Model.TotalCustomers</strong>
                            </div>
                        </div>
                        <div class="summary-footer">
                            <a href="@Url.Action("Index", "Customer")" class="text-muted text-uppercase">Tüm Müşteriler</a>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <div class="col-xl-4 col-md-6 mb-4">
        <section class="card card-featured card-featured-success">
            <div class="card-body">
                <div class="widget-summary">
                    <div class="widget-summary-col widget-summary-col-icon">
                        <div class="summary-icon bg-success">
                            <i class="fas fa-tasks"></i>
                        </div>
                    </div>
                    <div class="widget-summary-col">
                        <div class="summary">
                            <h4 class="title">Toplam Görev</h4>
                            <div class="info">
                                <strong class="amount">@Model.TotalTasks</strong>
                            </div>
                        </div>
                        <div class="summary-footer">
                            <a href="@Url.Action("Index", "Tasks")" class="text-muted text-uppercase">Görev Listesi</a>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <div class="col-xl-4 col-md-6 mb-4">
        <section class="card card-featured card-featured-warning">
            <div class="card-body">
                <div class="widget-summary">
                    <div class="widget-summary-col widget-summary-col-icon">
                        <div class="summary-icon bg-warning">
                            <i class="fas fa-sticky-note"></i>
                        </div>
                    </div>
                    <div class="widget-summary-col">
                        <div class="summary">
                            <h4 class="title">Toplam Notlar</h4>
                            <div class="info">
                                <strong class="amount">@Model.TotalNotes</strong>
                            </div>
                        </div>
                        <div class="summary-footer">
                            <a href="@Url.Action("Index", "Notes")" class="text-muted text-uppercase">Tüm Notlar</a>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

<div class="row mb-4">
    <div class="col-lg-6 mb-4 mb-lg-0">
        <section class="card h-100">
            <header class="card-header">
                <h2 class="card-title">Aylık Müşteri Kayıtları</h2>
                <p class="card-subtitle">Son 6 aydaki müşteri artış grafiği</p>
            </header>
            <div class="card-body">
                <div class="chart-container" style="position: relative; height:300px; width:100%">
                    <canvas id="customerChart"></canvas>
                </div>
            </div>
        </section>
    </div>

    <div class="col-lg-6">
        <section class="card h-100">
            <header class="card-header">
                <h2 class="card-title">Görev Durum Dağılımı</h2>
                <p class="card-subtitle">Görevlerin statülerine göre dağılımı</p>
            </header>
            <div class="card-body">
                <div class="chart-container" style="position: relative; height:300px; width:100%">
                    <canvas id="taskChart"></canvas>
                </div>
            </div>
        </section>
    </div>
</div>

<section class="card card-modern">
    <header class="card-header">
        <h4 class="card-title">Son Eklenen Müşteriler</h4>
    </header>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th>Ad</th>
                        <th>Email</th>
                        <th>Telefon</th>
                        <th>Görevler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var customer in Model.Customers)
                    {
                        <tr>
                            <td>
                                <a asp-controller="Customer" asp-action="Details" asp-route-id="@customer.Id" class="text-dark font-weight-bold">
                                    @customer.FullName
                                </a>
                            </td>
                            <td>@customer.Email</td>
                            <td>@customer.Phone</td>
                            <td>
                                @{
                                    int taskCount = customer.Tasks?.Count ?? 0;
                                }
                                @if (taskCount > 0)
                                {
                                    <span class="badge badge-info" style="font-size: 0.9em;">
                                        @taskCount Görev
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function() {

            // --- VERİLERİN ALINMASI ---
            var customerLabels = @Html.Raw(Json.Serialize(Model.CustomerGraphLabels));
            var customerValues = @Html.Raw(Json.Serialize(Model.CustomerGraphValues));

            var taskLabels = @Html.Raw(Json.Serialize(Model.TaskStatusLabels));
            var taskValues = @Html.Raw(Json.Serialize(Model.TaskStatusValues));

            // --- 1. GRAFİK: MÜŞTERİ (LINE CHART) ---
            var ctx1 = document.getElementById('customerChart').getContext('2d');
            new Chart(ctx1, {
                type: 'line',
                data: {
                    labels: customerLabels,
                    datasets: [{
                        label: 'Yeni Müşteri',
                        data: customerValues,
                        borderColor: '#0088cc', // Porto Mavi
                        backgroundColor: 'rgba(0, 136, 204, 0.2)',
                        borderWidth: 2,
                        fill: true,
                        tension: 0.4, // Kıvrımlı çizgi
                        pointRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false } // Tek veri olduğu için lejantı gizle
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { stepSize: 1 } // Tam sayı göster
                        }
                    }
                }
            });

            // --- 2. GRAFİK: GÖREVLER (DOUGHNUT CHART) ---
            var ctx2 = document.getElementById('taskChart').getContext('2d');

            // Renk Paleti (Porto Teması Uyumlu)
            var colors = ['#28a745', '#ffc107', '#dc3545', '#17a2b8', '#6c757d'];

            new Chart(ctx2, {
                type: 'doughnut',
                data: {
                    labels: taskLabels,
                    datasets: [{
                        data: taskValues,
                        backgroundColor: colors,
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                padding: 20,
                                usePointStyle: true
                            }
                        }
                    }
                }
            });
        });
    </script>
}