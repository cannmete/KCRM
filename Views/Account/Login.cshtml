@model KCRM.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Giriş Yap";
    Layout = "_LayoutLogReg";
}

<a href="/" class="logo float-start">
    <img src="~/img/logo.png" height="70" alt="KETCH STUDIO" />
</a>

<div class="panel card-sign">
    <div class="card-title-sign mt-3 text-end">
        <h2 class="title text-uppercase font-weight-bold m-0">
            <i class="bx bx-user-circle me-1 text-6 position-relative top-5"></i> Giriş Yap
        </h2>
    </div>

    <div class="card-body">

        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group mb-3">
                <label>Kullanıcı Adı</label>
                <div class="input-group">
                    <input asp-for="Username" class="form-control form-control-lg" />
                    <span class="input-group-text">
                        <i class="bx bx-user text-4"></i>
                    </span>
                </div>
                <span asp-validation-for="Username" class="text-danger small"></span>
            </div>

            <div class="form-group mb-3">
                <div class="clearfix">
                    <label class="float-start">Şifre</label>
                </div>
                <div class="input-group">
                    <input asp-for="Password" type="password" class="form-control form-control-lg" />
                    <span class="input-group-text">
                        <i class="bx bx-lock text-4"></i>
                    </span>
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="row">
                <div class="col-sm-8">
                    <div class="checkbox-custom checkbox-default">
                        <input asp-for="KeepMe" type="checkbox" id="RememberMe" />
                        <label for="RememberMe">Beni Hatırla</label>
                    </div>
                </div>
                <div class="col-sm-4 text-end">
                    <button type="submit" class="btn btn-primary mt-2">Giriş</button>
                </div>
            </div>

        </form>
    </div>
</div>

<p class="text-center text-muted mt-3 mb-3">&copy; @DateTime.Now.Year KETCH STUDIO | Tüm hakları saklıdır.</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}