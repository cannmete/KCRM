@model KCRM.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Kayıt Ol";
    Layout = "_LayoutLogReg";
}

<div asp-validation-summary="ModelOnly" class="text-danger alert alert-warning"></div>

<form asp-action="Register" method="post">

    <div class="form-group mb-3">
        <label class="form-label">Kullanıcı Adı</label>
        <div class="input-group">
            <input asp-for="Username" class="form-control form-control-lg" placeholder="Kullanıcı adınızı giriniz." />
            <span class="input-group-text">
                <i class="bx bx-user text-muted"></i> @* Kullanıcı ikonu *@
            </span>
        </div>
        <span asp-validation-for="Username" class="text-danger small"></span>
    </div>

    <div class="form-group mb-3">
        <label class="form-label">E-Posta Adresi</label>
        <div class="input-group">
            <input asp-for="Email" class="form-control form-control-lg" placeholder="E-postanızı giriniz." />
            <span class="input-group-text">
                <i class="fas fa-envelope text-muted"></i> @* Zarf ikonu *@
            </span>
        </div>
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    <div class="form-group mb-3">
        <label class="form-label">Şifre</label>
        <div class="input-group">
            <input asp-for="Password" type="password" class="form-control form-control-lg" placeholder="Şifrenizi giriniz." />
            <span class="input-group-text">
                <i class="fas fa-lock text-muted"></i> @* Kilit ikonu *@
            </span>
        </div>
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>

    <div class="form-group mb-3">
        <label class="form-label">Şifre Tekrar</label>
        <div class="input-group">
            <input asp-for="ConfirmPassword" type="password" class="form-control form-control-lg" placeholder="Şifrenizi tekrar giriniz." />
            <span class="input-group-text">
                <i class="fas fa-lock text-muted"></i>
            </span>
        </div>
        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
    </div>

    <div class="d-grid mt-4">
        <button type="submit" class="btn btn-primary btn-block">Kayıt Ol</button>
    </div>

    <p class="mt-3 text-center">
        Zaten hesabınız var mı? <a asp-action="Login">Giriş Yap</a>
    </p>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}