@model KCRM.ViewModels.TaskAddViewModel
@{
    ViewData["Title"] = "Yeni Görev Ekle";
    Layout = "_LayoutPorto";
}

<section role="main" class="content-body">
    <header class="page-header">
        <h2>Yeni Görev Ekle</h2>
    </header>

    <div class="row">
        <div class="col-lg-8">
            <section class="card card-modern">
                <div class="card-body">
                    <form asp-action="Add" method="post">

                        <div class="form-group mb-3">
                            <label class="control-label font-weight-bold">Bu görev kiminle ilgili?</label>
                            <div class="d-flex mt-2">
                                <div class="radio-custom radio-primary me-4">
                                    <input type="radio" id="radioNone" name="RelatedType" value="None" checked onchange="toggleSelects()">
                                    <label for="radioNone">Genel (Bağlantısız)</label>
                                </div>
                                <div class="radio-custom radio-success me-4">
                                    <input type="radio" id="radioCustomer" name="RelatedType" value="Customer" onchange="toggleSelects()">
                                    <label for="radioCustomer">Müşteri</label>
                                </div>
                                <div class="radio-custom radio-warning">
                                    <input type="radio" id="radioLead" name="RelatedType" value="Lead" onchange="toggleSelects()">
                                    <label for="radioLead">Aday (Lead)</label>
                                </div>
                            </div>
                        </div>

                        <div class="form-group mb-3" id="divCustomerSelect" style="display:none;">
                            <label class="control-label">Müşteri Seçiniz</label>
                            <select asp-for="Task.CustomerId" class="form-control" asp-items="Model.CustomerList">
                                <option value="">--- Seçiniz ---</option>
                            </select>
                        </div>

                        <div class="form-group mb-3" id="divLeadSelect" style="display:none;">
                            <label class="control-label">Aday (Lead) Seçiniz</label>
                            <select asp-for="Task.LeadId" class="form-control" asp-items="Model.LeadList">
                                <option value="">--- Seçiniz ---</option>
                            </select>
                        </div>

                        <hr />

                        <div class="form-group mb-3">
                            <label class="control-label">Başlık *</label>
                            <input asp-for="Task.Title" class="form-control" placeholder="Örn: Toplantı yapılacak" />
                            <span asp-validation-for="Task.Title" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 form-group mb-3">
                                <label class="control-label">Öncelik</label>
                                <select asp-for="Task.Priority" class="form-control" asp-items="Html.GetEnumSelectList<KCRM.Models.TaskPriority>()"></select>
                            </div>
                            <div class="col-md-6 form-group mb-3">
                                <label class="control-label">Durum</label>
                                <select asp-for="Task.Status" class="form-control" asp-items="Html.GetEnumSelectList<KCRM.Models.TaskStatus>()"></select>
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            <label class="control-label">Bitiş Tarihi</label>
                            <input asp-for="Task.DueDate" type="date" class="form-control" />
                        </div>

                        <div class="form-group mb-3">
                            <label class="control-label">Açıklama</label>
                            <textarea asp-for="Task.Description" class="form-control" rows="4"></textarea>
                        </div>

                        <div class="form-group text-end mt-4">
                            <a asp-action="Index" class="btn btn-default me-2">İptal</a>
                            <button type="submit" class="btn btn-primary">Kaydet</button>
                        </div>

                    </form>
                </div>
            </section>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function toggleSelects() {
            // Seçili radio butonunu bul
            var type = document.querySelector('input[name="RelatedType"]:checked').value;

            // Divleri al
            var divCustomer = document.getElementById('divCustomerSelect');
            var divLead = document.getElementById('divLeadSelect');

            // Seçimleri sıfırla (Arka planda yanlış veri gitmesin)
            // document.querySelector('#divCustomerSelect select').value = "";
            // document.querySelector('#divLeadSelect select').value = "";

            // Görünürlüğü ayarla
            if (type === 'Customer') {
                divCustomer.style.display = 'block';
                divLead.style.display = 'none';
            } else if (type === 'Lead') {
                divCustomer.style.display = 'none';
                divLead.style.display = 'block';
            } else {
                divCustomer.style.display = 'none';
                divLead.style.display = 'none';
            }
        }
    </script>
}