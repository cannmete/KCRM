@model IEnumerable<KCRM.Models.TaskItem>
@{
    ViewData["Title"] = "Görevler";
    Layout = "_LayoutPorto";
}

<section role="main" class="content-body">
    <header class="page-header d-flex justify-content-between align-items-center mb-3">
        <h2>Görev Listesi</h2>
        <a asp-action="Add" class="mb-1 mt-1 me-1 btn btn-success">
            <i class="fas fa-plus"></i> Yeni Görev Oluştur
        </a>
    </header>

    <section class="card card-modern">
        <header class="card-header">
            <h4 class="card-title">Tüm Görevler</h4>
        </header>
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-bordered table-striped mb-0" id="datatable-default">
                    <thead>
                        <tr>
                            <th>Başlık</th>
                            <th>İlgili Kişi</th>
                            <th>Öncelik</th>
                            <th>Durum</th>
                            <th>Bitiş Tarihi</th>
                            <th style="width: 10%;">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var task in Model)
                        {
                            <tr>
                                <td class="font-weight-bold text-dark">@task.Title</td>

                                <td>
                                    @if (task.Customer != null)
                                    {
                                        <a asp-controller="Customer" asp-action="Details" asp-route-id="@task.CustomerId" class="text-primary">
                                            <i class="fas fa-user"></i> @task.Customer.FullName
                                        </a>
                                    }
                                    else if (task.Lead != null)
                                    {
                                        <a asp-controller="Leads" asp-action="Edit" asp-route-id="@task.LeadId" class="text-warning">
                                            <i class="fas fa-user-tag"></i> @task.Lead.FullName (Aday)
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Genel Görev</span>
                                    }
                                </td>

                                <td>
                                    @if (task.Priority == KCRM.Models.TaskPriority.Acil)
                                    {
                                        <span class="badge badge-danger">Acil</span>
                                    }
                                    else if (task.Priority == KCRM.Models.TaskPriority.Yüksek)
                                    {
                                        <span class="badge badge-warning text-dark">Yüksek</span>
                                    }
                                    else if (task.Priority == KCRM.Models.TaskPriority.Orta)
                                    {
                                        <span class="badge badge-info">Orta</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-default text-dark">Düşük</span>
                                    }
                                </td>

                                <td>
                                    @if (task.Status == KCRM.Models.TaskStatus.Tamamlandi)
                                    {
                                        <span class="badge badge-success">Tamamlandı</span>
                                    }
                                    else if (task.Status == KCRM.Models.TaskStatus.Iptal)
                                    {
                                        <span class="badge badge-dark">İptal</span>
                                    }
                                    else if (task.Status == KCRM.Models.TaskStatus.Islemde)
                                    {
                                        <span class="badge badge-primary">İşlemde</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-warning text-dark">Bekliyor</span>
                                    }
                                </td>

                                <td>
                                    @if (task.DueDate != DateTime.MinValue)
                                    {
                                        // Tarih geçmişse kırmızı yapalım
                                        <span class="@(task.DueDate < DateTime.Now && task.Status != KCRM.Models.TaskStatus.Tamamlandi ? "text-danger font-weight-bold" : "")">
                                            @task.DueDate.ToShortDateString()
                                        </span>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>

                                <td class="actions">
                                    <div class="d-flex flex-row">
                                        <a asp-action="Details" asp-route-id="@task.Id" class="btn btn-sm btn-info me-1" title="Detay">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@task.Id" class="btn btn-sm btn-warning me-1" title="Düzenle">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </section>
</section>

@section Scripts {
    @* DataTables scripti layout'ta varsa burası boş kalabilir *@
}