@model KCRM.ViewModels.CustomerIndexViewModel
@{
    ViewData["Title"] = "Müşteriler";
    Layout = "_LayoutPorto";
}

<section role="main" class="content-body">
    @* Porto'nun ana içerik kapsayıcısı *@

    <header class="page-header d-flex justify-content-between align-items-center mb-3">
        <h2>Müşteriler</h2>
        <button type="button" class="mb-1 mt-1 me-1 btn btn-success" data-bs-toggle="modal" data-bs-target="#addCustomerModal">
            <i class="fas fa-plus"></i> Yeni Müşteri Ekle
        </button>
    </header>

    <div class="modal fade" id="addCustomerModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">

                <header class="card-header">
                    <h2 class="card-title" id="addCustomerLabel">Yeni Müşteri Ekle</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </header>

                <div class="card-body">
                    @await Html.PartialAsync("_AddCustomerPartial", new KCRM.Models.Customer())
                </div>

            </div>
        </div>
    </div>

    <div class="row">

        <div class="col-lg-6">
            <section class="card card-modern">
                <header class="card-header">
                    <h4 class="card-title">Yeni Müşteriler</h4>
                </header>
                <div class="card-body">
                    @foreach (var c in Model.Customers)
                    {
                        <div class="card card-modern card-border card-border-success mb-3">
                            <div class="card-body">
                                <h5 class="card-title">@c.FullName</h5>
                                <p class="card-text text-muted"><strong>Email:</strong> @c.Email</p>
                                <p class="card-text text-muted"><strong>Telefon:</strong> @c.Phone</p>
                                <p class="card-text text-muted"><strong>Adres:</strong> @c.Address</p>

                                <div class="mt-3">
                                    <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-info">Detay</a>
                                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-warning">Düzenle</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </section>
        </div>

        <div class="col-lg-6">
            <section class="card card-modern">
                <header class="card-header">
                    <h4 class="card-title">Potansiyel Müşteriler</h4>
                </header>
                <div class="card-body">
                    @foreach (var c in Model.Leads)
                    {
                        <div class="card card-modern card-border card-border-warning mb-3">
                            <div class="card-body">
                                <h5 class="card-title">@c.FullName</h5>
                                <p class="card-text text-muted"><strong>Email:</strong> @c.Email</p>
                                <p class="card-text text-muted"><strong>Telefon:</strong> @c.Phone</p>
                                <p class="card-text text-muted"><strong>Adres:</strong> @c.Address</p>


                                <div class="mt-3">
                                    <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-info">Detay</a>
                                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-warning">Düzenle</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </section>
        </div>
    </div>

</section>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}