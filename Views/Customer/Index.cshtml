@model KCRM.ViewModels.CustomerIndexViewModel
@{
    ViewData["Title"] = "Müşteriler";
    Layout = "_LayoutPorto";
}

<section role="main" class="content-body">

    <header class="page-header d-flex justify-content-between align-items-center mb-3">
        <h2>Müşteriler</h2>
        <button type="button" class="mb-1 mt-1 me-1 btn btn-success" data-bs-toggle="modal" data-bs-target="#addCustomerModal">
            <i class="fas fa-plus"></i> Yeni Müşteri Ekle
        </button>
    </header>

    <div class="modal fade" id="addCustomerModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <header class="card-header">
                    <h2 class="card-title" id="addCustomerLabel">Yeni Müşteri Ekle</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </header>
                <div class="card-body">
                    @await Html.PartialAsync("_AddCustomerPartial", new KCRM.Models.Customer())
                </div>
            </div>
        </div>
    </div>

    @if (!Model.Customers.Any())
    {
        <div class="alert alert-info">
            Henüz hiç müşteri eklenmemiş. "Yeni Müşteri Ekle" butonu ile başlayabilirsiniz.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var c in Model.Customers)
            {
                <div class="col-xl-3 col-lg-4 col-md-6 col-12 mb-4">

                    <section class="card card-featured-left card-featured-primary h-100">
                        <div class="card-body">

                            <div class="widget-summary">
                                <div class="widget-summary-col widget-summary-col-icon">
                                    <div class="summary-icon bg-primary">
                                        <i class="fas fa-user"></i>
                                    </div>
                                </div>
                                <div class="widget-summary-col">
                                    <div class="summary">
                                        <h4 class="title font-weight-bold">@c.FullName</h4>
                                        <div class="info">
                                            <span class="text-primary">Müşteri</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <hr class="solid short mt-3 mb-3">

                            <div class="customer-info">
                                <p class="mb-1"><i class="fas fa-envelope me-2 text-muted"></i> @(c.Email ?? "-")</p>
                                <p class="mb-1"><i class="fas fa-phone me-2 text-muted"></i> @(c.Phone ?? "-")</p>
                                <p class="mb-3 text-truncate" title="@c.Address"><i class="fas fa-map-marker-alt me-2 text-muted"></i> @(c.Address ?? "-")</p>
                            </div>

                            <div class="d-flex justify-content-between mt-auto">
                                <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-info w-50 me-1">Detay</a>
                                <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-warning w-50 ms-1">Düzenle</a>
                            </div>

                        </div>
                    </section>

                </div>
            }
        </div>
    }

</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}