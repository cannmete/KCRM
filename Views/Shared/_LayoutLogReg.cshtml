<!doctype html>
<html class="fixed">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - KETCH STUDIO</title>

    <link href="https://fonts.googleapis.com/css?family=Poppins:300,400,500,600,700,800|Shadows+Into+Light" rel="stylesheet" type="text/css">

    <link rel="stylesheet" href="~/porto-admin/vendor/bootstrap/css/bootstrap.css" />
    <link rel="stylesheet" href="~/porto-admin/vendor/font-awesome/css/all.min.css" />
    <link rel="stylesheet" href="~/porto-admin/vendor/boxicons/css/boxicons.min.css" />
    <link rel="stylesheet" href="~/porto-admin/css/theme.css" />

    <link rel="stylesheet" href="~/porto-admin/css/skins/default.css" />

    <link rel="stylesheet" href="~/porto-admin/css/custom.css" />

    <script src="~/porto-admin/vendor/modernizr/modernizr.js"></script>
</head>
<body>
    <section class="body-sign">
        <div class="center-sign">
            @RenderBody()
        </div>
    </section>
    <script src="~/porto-admin/vendor/jquery/jquery.js"></script>
    <script src="~/porto-admin/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/porto-admin/js/theme.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>