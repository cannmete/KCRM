@model IEnumerable<KCRM.Models.Notes>
@{
    ViewData["Title"] = "Notlar";
    Layout = "_LayoutSbAdmin";
}
    
<h2>Notlar</h2>

<a asp-action="Add" class="btn btn-primary mb-3">Yeni Not Ekle</a>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>İçerik</th>
            <th>User Id</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Content</td>
                <td>@item.UserId</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Detay</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Düzenle</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Sil</a>
                </td>
            </tr>
        }
    </tbody>
</table>
