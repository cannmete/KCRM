@model KCRM.ViewModels.NotesAddViewModel
@{
    ViewData["Title"] = "Not Ekle";
    Layout = "_LayoutPorto";
}

<section role="main" class="content-body">
    <header class="page-header">
        <h2>Yeni Not Ekle</h2>
    </header>

    <div class="row">
        <div class="col-lg-8">
            <section class="card card-modern">
                <div class="card-body">

                    <form asp-action="Add" method="post">

                        <div asp-validation-summary="All" class="alert alert-danger"></div>
                        <div class="form-group mb-3">
                            <label class="control-label font-weight-bold">İlgili Müşteri</label>
                            <select asp-for="Note.CustomerId"
                                    class="form-control"
                                    asp-items="Model.CustomerList">
                                <option value="">--- Müşteri Seçiniz ---</option>
                            </select>
                        </div>

                        <div class="form-group mb-3">
                            <label class="control-label font-weight-bold">Not İçeriği</label>
                            <textarea asp-for="Note.Content" class="form-control" rows="5" placeholder="Notunuzu buraya girin..."></textarea>
                            <span asp-validation-for="Note.Content" class="text-danger"></span>
                        </div>

                        <div class="form-group text-end mt-4">
                            <a asp-action="Index" class="btn btn-default me-2">İptal</a>
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save"></i> Kaydet
                            </button>
                        </div>

                    </form>

                </div>
            </section>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}