@model KCRM.Models.Notes
@{
    ViewData["Title"] = "Notu Sil";
    Layout = "_LayoutPorto";
}

<h2>Not Detayı</h2>

<div class="card p-3">
    <p><strong>Id:</strong> @Model.Id</p>
    <p><strong>İçerik:</strong> @Model.Content</p>
    <p><strong>User ID:</strong> @Model.UserId</p>
</div>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning mt-3">Düzenle</a>
<a asp-action="Index" class="btn btn-secondary mt-3">Geri Dön</a>
