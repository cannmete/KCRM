@model KCRM.Models.Notes
@{
    // Bu sayfanın hem detay hem de silme onayı için kullanılabileceğini varsayıyoruz.
    ViewData["Title"] = "Not Detayları";
    Layout = "_LayoutPorto";
}

<section role="main" class="content-body">

    <header class="page-header mb-4">
        <h2>@ViewData["Title"]</h2>
    </header>

    <div class="row">
        <div class="col-lg-8">

            <section class="card card-modern">
                <header class="card-header bg-default">
                    @* Başlık çubuğunu koyu yaparak dikkat çekiyoruz *@
                    <h4 class="card-title text-dark">Not ID: @Model.Id</h4>
                </header>
                <div class="card-body">

                    <h5 class="mb-3 text-primary">İçerik:</h5>
                    <p class="alert alert-info border-info">@Model.Content</p>

                    <hr />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <h6><i class="fas fa-user-circle me-2"></i> Ekleyen Kullanıcı</h6>
                            <p class="text-muted">
                                **Kullanıcı Adı:** @(Model.User?.Username ?? "YOK")<br />
                                **User ID:** @Model.UserId
                            </p>
                        </div>

                        <div class="col-md-6 mb-3">
                            <h6><i class="fas fa-users me-2"></i> İlgili Müşteri</h6>
                            <p class="text-muted">
                                @if (Model.Customer != null)
                                {
                                <p class="mb-0">
                                    <strong>Adı:</strong> @Model.Customer.FullName
                                </p>
                                <p class="mb-0">
                                    <strong>Telefon:</strong> @Model.Customer.Phone
                                </p>
                            }
                                else
                                {
                                    <span>Müşteri Atanmamış (Genel Not)</span>
                                }
                            </p>
                        </div>
                    </div>

                </div>
            </section>

        </div>
    </div>

</section>