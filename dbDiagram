Table notes {
  Id integer [primary key]
  Content varchar
  UserId integer [not null]
  IsDeleted integer
}

Table users {
  Id integer [primary key]
  Username varchar
  Email varchar
  Role varchar 
  PasswordSalt longblob
  PasswordHash longblob
}

Table tasks {
  Id integer [primary key]
  Title varchar
  Description varchar
  UserId integer [not null]
  CustomerId integer
  IsDeleted integer
  IsCompleted integer
  CreatedAt datetime
  DueDate datetime
  
}

Table customers {
  Id integer
  FullName varchar
  Email varchar
  Phone varchar
  Adress varchar
  IsDeleted integer
  CreatedAt datetime
  UserId integer
  IsLead tinyint
}




Ref: "users"."Id" < "notes"."UserId"

Ref: "tasks"."CustomerId" < "customers"."Id"

Ref: "tasks"."UserId" < "users"."Id"

Ref: "customers"."UserId" < "users"."Id"
